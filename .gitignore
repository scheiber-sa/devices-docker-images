# .gitignore for Garmin Docker Images (public repository)

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.code-workspace

# Docker
.dockerignore
docker-compose.override.yml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Environment files (with actual secrets)
.env.local
.env.*.local

# Node (if used in any tooling)
node_modules/
npm-debug.log
yarn-error.log

# Build outputs
dist/
build/
out/
